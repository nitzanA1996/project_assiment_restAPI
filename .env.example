NODE_ENV=development
PORT=3000

DB_TARGET=atlas
MONGODB_DB_NAME=business_cards
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/business_cards
# Paste the plain connection string from Atlas here, without Markdown links.
MONGODB_ATLAS_URI=
# Required: generate a random secret of at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173

# Optional for development seed; required in production. Keep custom values private.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
